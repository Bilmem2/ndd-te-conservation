# ── Downloaded raw data (large; fetched by scripts/00_download_data.sh) ──
# Per-assembly genome/annotation/RepeatMasker dirs and their derived files.
# Committed inputs (data/gene_lists/, data/orthologs/) are intentionally NOT ignored.
data/hg38/
data/ponAbe3/
data/nomLeu3/
data/rheMac10/
data/calJac4/
data/saiBol1/
data/mmur3/
data/mm10/
data/canFam6/

# Large auxiliary downloads added for the revision. Fetched by 00_download_data.sh
# except the liftOver binary in tools/, which is a platform-specific UCSC build.
data/chains/
data/clinvar_variants.txt.gz
data/gnomad_constraint.tsv
tools/

# Gene-set sources for 01_prepare_gene_lists.py. All are free downloads (see the
# README table for the URLs); they are kept out of the repository because they
# are third-party files, not because they are hard to obtain.
data/sources/

# ── Kept out of the public repository ──
# The manuscript sources and the private working material (reviewer
# correspondence, drafts, reference PDFs) are deliberately not published here.
# These were previously only in .git/info/exclude, which is local to one clone
# and is not backed up; listing them here makes the exclusion durable.
manuscript/
private/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
*.swp
